{
  "name": "behavior-rocker",
  "version": "0.1.0",
  "description": "An accessible, fully customizable two-choice React control for decisions that go beyond on or off.",
  "license": "MIT",
  "author": "Actually Better",
  "keywords": [
    "react",
    "component",
    "ui",
    "accessibility",
    "radio",
    "toggle",
    "binary-choice"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actually-Better/behavior-rocker.git"
  },
  "bugs": {
    "url": "https://github.com/Actually-Better/behavior-rocker/issues"
  },
  "homepage": "https://github.com/Actually-Better/behavior-rocker#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/behavior-rocker.cjs",
  "module": "./dist/behavior-rocker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/behavior-rocker.js",
      "require": "./dist/behavior-rocker.cjs"
    },
    "./styles.css": "./dist/behavior-rocker.css"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.0.2",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
